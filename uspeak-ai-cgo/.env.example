# =============================================================================
# AI CGO 環境変数テンプレート
# このファイルを `.env` にコピーして値を埋めてください（.envはgit管理対象外）
# =============================================================================

# --- Claude API ---
# https://console.anthropic.com/ から取得
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Google Sheets ---
# Google SheetsのURLから抽出: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=1abc...xyz
# シート内のタブ名（デフォルト: 営業活動ログ）
SHEET_RANGE=営業活動ログ!A:O
# サービスアカウントのJSONファイル全体をbase64エンコードした文字列
# 生成方法: base64 -w 0 credentials.json
GOOGLE_CREDENTIALS_BASE64=ewogICJ0eXBlIj...

# --- Slack ---
# https://api.slack.com/messaging/webhooks で作成
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
SLACK_CHANNEL=#cgo-report

# --- 任意設定 ---
# 分析対象の期間（日数、デフォルト14）
ANALYSIS_PERIOD_DAYS=14
# 最低必要データ件数（これ未満ならスキップ）
MIN_DATA_COUNT=10
